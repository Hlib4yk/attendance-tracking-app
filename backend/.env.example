# Copy to .env and adjust if needed.
# After `docker compose up -d` from the project root, this URL matches docker-compose.yml.
DATABASE_URL="postgresql://diploma:diploma_secret@localhost:5432/diploma"

# Public URL of the Next.js app (used in teacher invite links).
FRONTEND_URL="http://localhost:3000"

# --- Email (Resend): create key at https://resend.com/api-keys ---
# If set, backend uses smtp.resend.com automatically (no SMTP_HOST needed).
RESEND_API_KEY=""
# Optional until you verify a domain in Resend; for testing use onboarding@resend.dev (Resend docs).
MAIL_FROM="onboarding@resend.dev"

# --- Face recognition (InsightFace HTTP service; `docker compose up face-service` then set URL) ---
# FACE_SERVICE_URL="http://localhost:8787"
# Cosine similarity threshold for normalized embeddings (typical 0.35–0.55).
# FACE_MATCH_THRESHOLD="0.45"

# --- LPNU schedule adapter (HTML parse + cache in Postgres; TTL seconds, 60–21600, default 4h) ---
# LPNU_SCHEDULE_CACHE_TTL_SEC="14400"
# LPNU_HTTP_USER_AGENT="DiplomaScheduleAdapter/1.0 (your@email)"

# --- Email (generic SMTP, optional — overrides Resend when SMTP_HOST is set) ---
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
